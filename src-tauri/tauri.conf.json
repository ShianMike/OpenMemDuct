{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMemDuct",
  "version": "0.1.2",
  "identifier": "org.openmemduct.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["dashboard"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenMemDuct contributors",
    "homepage": "https://github.com/ShianMike/OpenMemDuct",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Windows memory monitoring and cleanup",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyOTIyRkI3MTk3NDMzQkMKUldTOE0zUVp0eStTa3E2c04vWmtiMGk5SVAzcXBvc04yOWUybjZPVWxOaDlMWlR2ZXZuKzZsT0MK",
      "endpoints": [
        "https://github.com/ShianMike/OpenMemDuct/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
