{
  "name": "openmemduct",
  "private": true,
  "version": "0.1.1",
  "description": "A Windows memory monitor and cleanup app built with React, Tauri, and Rust.",
  "license": "MIT",
  "homepage": "https://github.com/ShianMike/OpenMemDuct#readme",
  "repository": {
    "type": "git",
